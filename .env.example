# Configuración del Servidor TR-069
# Copia este archivo como .env y modifica los valores según tu entorno

# Clave secreta para Flask (cambiar en producción)
SECRET_KEY=tr069-secret-key-change-in-production

# Base de datos MySQL
DATABASE_URL=mysql+pymysql://tr069:tr069pass@localhost/tr069_onts

# Configuración TR-069 ACS
TR069_ACS_URL=http://localhost:5000/acs
TR069_ACS_USERNAME=acs
TR069_ACS_PASSWORD=acspass
TR069_ACS_PORT=7547

# Configuración de red por defecto
DEFAULT_VLAN_ID=100
DEFAULT_PPPOE_USERNAME=user
DEFAULT_PPPOE_PASSWORD=pass
DEFAULT_DNS_PRIMARY=8.8.8.8
DEFAULT_DNS_SECONDARY=8.8.4.4

# Configuración WiFi por defecto
DEFAULT_WIFI_2_4_SSID=Huawei-ONT-2.4G
DEFAULT_WIFI_5_SSID=Huawei-ONT-5G
DEFAULT_WIFI_PASSWORD=Huawei123456

# Configuración de monitoreo
MONITORING_INTERVAL=300
OPTICAL_POWER_THRESHOLD=-25.0

# Configuración de archivos
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Configuración de logging
LOG_LEVEL=INFO
LOG_FILE=logs/tr069_server.log